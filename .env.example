APP_NAME=Mi-Stock
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mi-stock-api.onrender.com

DB_CONNECTION=mongodb
MONGO_DSN="mongodb+srv://usuario:contraseña@cluster.mongodb.net/mi_stock?retryWrites=true&w=majority"
DB_HOST=127.0.0.1
DB_PORT=27017
DB_DATABASE=mi_stock
DB_USERNAME=
DB_PASSWORD=
DB_AUTHDATABASE=admin

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
